{
  "_说明": "遮罩区域定义。坐标为归一化值(0~1)，相对图片宽高。add=可编辑区域，sub=从可编辑区里挖掉(要保留的部分)。配合 tools/make_mask.py 使用。",

  "items": [
    {
      "_注释": "示例：只改天空区域（图片上半部分）",
      "name": "sky",
      "image": "ref/photo.png",
      "add": [
        [[0.0, 0.0], [1.0, 0.0], [1.0, 0.38], [0.0, 0.32]]
      ],
      "sub": [],
      "feather": 6
    },
    {
      "_注释": "示例：改画面中央区域，但保留中间的主体细节",
      "name": "center",
      "image": "ref/photo.png",
      "add": [
        [[0.18, 0.18], [0.82, 0.18], [0.82, 0.82], [0.18, 0.82]]
      ],
      "sub": [
        [[0.40, 0.40], [0.60, 0.40], [0.60, 0.60], [0.40, 0.60]]
      ],
      "feather": 6
    }
  ]
}
